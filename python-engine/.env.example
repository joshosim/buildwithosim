# Copy to .env and edit, then load it before starting the server (see README).
# Every setting is optional; the values below are the defaults.

# Browser origins allowed to call this API (comma-separated, no trailing slashes).
# Set this to your site's origin(s) in production.
STEM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Scratch space for uploads and results. Defaults to <system temp>/stem-engine.
# Only directories named like a job id (32 hex characters) inside it are ever deleted.
# STEM_WORK_DIR=

STEM_MAX_UPLOAD_MB=150
STEM_MAX_DURATION_SECONDS=600
# How long finished results stay downloadable before they are deleted.
STEM_JOB_TTL_SECONDS=3600
STEM_SWEEP_INTERVAL_SECONDS=60

# Jobs that may be waiting or running at once. Further uploads get HTTP 429.
STEM_MAX_QUEUE=8
# Separations that run at the same time. Keep at 1 unless you have the memory for more.
STEM_MAX_CONCURRENT_JOBS=1

# auto | cpu | cuda | mps
STEM_DEVICE=auto
# CPU threads for chunk-level parallelism (0 = off). More threads means more RAM.
STEM_JOBS=0
# Random-shift averaging passes. 1 is Demucs' default; 0 is faster and slightly less accurate.
STEM_SHIFTS=1
# Models kept in memory at once.
STEM_MODEL_CACHE_SIZE=1

# htdemucs_vocals, htdemucs, htdemucs_ft, htdemucs_6s (comma-separated)
STEM_ENABLED_MODELS=htdemucs_vocals,htdemucs,htdemucs_ft,htdemucs_6s
STEM_DEFAULT_MODEL=htdemucs

# BUILDWITHOSIM Reader. Voice reference is private and never served as a static file.
# READER_DATA_DIR=
